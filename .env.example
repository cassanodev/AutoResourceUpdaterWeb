# Website
NEXT_PUBLIC_SITE_URL=https://autoresourceupdater.app
NEXT_PUBLIC_DISCORD_URL=https://discord.gg/your-server
INSTALLER_DOWNLOAD_URL=https://github.com/cassanodev/AutoResourceUpdater-Releases/releases/latest/download/AutoResourceUpdater-Setup.exe

# Discord / Auth.js (server only except where explicitly marked NEXT_PUBLIC)
AUTH_SECRET=
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# Central VPS API. This value is read only by Next.js server routes.
BACKEND_API_URL=https://api.your-vps.example
# Optional override if the desktop API lives on a different VPS service.
# DESKTOP_BACKEND_API_URL=https://desktop-api.your-vps.example

# Configure the backend VPS with this same public OAuth callback:
# DISCORD_REDIRECT_URI=https://autoresourceupdater.app/api/desktop/api/auth/callback/discord

# PayPal
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_URL=https://api-m.sandbox.paypal.com
